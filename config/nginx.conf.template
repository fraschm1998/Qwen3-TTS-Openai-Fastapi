upstream tts_backends {
    least_conn;
    server 127.0.0.1:8881;
    server 127.0.0.1:8882;
    server 127.0.0.1:8883;
    server 127.0.0.1:8884;
}

server {
    # Substituted by nginx's envsubst at container start (LB_PORT env var).
    # Default 8880; override when the port is taken (e.g. kokoro on epyc).
    listen ${LB_PORT};

    client_max_body_size 100M;

    # Longer timeouts for TTS generation
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_connect_timeout 10s;

    location / {
        proxy_pass http://tts_backends;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /health {
        # Health check hits both backends
        proxy_pass http://tts_backends;
    }
}
